---
interface Props {
  copyLabel: string;
  caption?: string;
  hint?: string;
}

const { copyLabel, caption, hint } = Astro.props;
const command = 'curl -fsSL https://lingtai.ai/install.sh | bash';
---

<div class="install-block">
  {caption && <p class="install-caption">{caption}</p>}
  <div class="install-pill">
    <span class="prompt">$</span>
    <span class="command">{command}</span>
    <button class="copy-btn" data-command={command}>{copyLabel}</button>
  </div>
  {hint && <p class="install-hint">{hint}</p>}
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const command = (btn as HTMLElement).dataset.command;
      if (command) {
        navigator.clipboard.writeText(command);
        const original = btn.textContent;
        btn.textContent = '✓';
        setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      }
    });
  });
</script>

<style>
  .install-block {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: min(100%, 720px);
  }
  .install-caption,
  .install-hint {
    margin: 0;
    color: var(--muted-text);
    font-family: "Noto Serif SC", serif;
    line-height: 1.6;
    text-align: left;
  }
  .install-caption {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .install-hint {
    max-width: 660px;
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  /* Ink slab (墨锭) — dark block, single sharp corner, vermilion action */
  .install-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 12px 22px;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--vermilion) 30%, transparent);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--vermilion) 18%, transparent);
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    font-size: 13px;
    letter-spacing: 0.5px;
  }
  .command {
    overflow-x: auto;
    white-space: nowrap;
    max-width: min(62vw, 480px);
  }
  .prompt {
    color: var(--vermilion);
  }
  .copy-btn {
    background: none;
    border: none;
    color: var(--vermilion);
    font-size: 12px;
    cursor: pointer;
    opacity: 0.85;
    font-family: "Noto Serif SC", serif;
    letter-spacing: 0.1em;
  }
  .copy-btn:hover {
    opacity: 1;
    text-shadow: 0 0 8px color-mix(in srgb, var(--vermilion) 50%, transparent);
  }
</style>
