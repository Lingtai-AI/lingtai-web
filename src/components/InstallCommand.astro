---
interface Props {
  copyLabel: string;
  showWindows?: boolean;
}

const { copyLabel, showWindows = false } = Astro.props;
const command = 'curl -fsSL https://lingtai.ai/install.sh | bash';
const powershellCommand = 'irm https://lingtai.ai/install.ps1 -OutFile install.ps1';
---

<div class="install-wrap" data-install-selector>
  <div class="install-pill">
    <span class="prompt">$</span>
    <span class="command">{command}</span>
    <button class="copy-btn" data-command={command}>{copyLabel}</button>
  </div>
  {showWindows && (
    <div class="platform-switch">
      <button
        class="platform-link active"
        type="button"
        aria-pressed="true"
        data-prompt="$"
        data-command={command}
      >macOS / Linux</button>
      <span class="platform-sep">·</span>
      <button
        class="platform-link"
        type="button"
        aria-pressed="false"
        data-prompt="PS>"
        data-command={powershellCommand}
      >PowerShell <span class="preview-label">experimental</span></button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const command = (btn as HTMLElement).dataset.command;
      if (command) {
        navigator.clipboard.writeText(command);
        const original = btn.textContent;
        btn.textContent = '✓';
        setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      }
    });
  });

  document.querySelectorAll('[data-install-selector]').forEach((root) => {
    const prompt = root.querySelector('.prompt');
    const command = root.querySelector('.command');
    const copy = root.querySelector('.copy-btn');

    root.querySelectorAll('.platform-link').forEach((link) => {
      link.addEventListener('click', () => {
        root.querySelectorAll('.platform-link').forEach((item) => {
          const active = item === link;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        const next = (link as HTMLElement).dataset;
        if (prompt && next.prompt) prompt.textContent = next.prompt;
        if (command && next.command) command.textContent = next.command;
        if (copy && next.command) (copy as HTMLElement).dataset.command = next.command;
      });
    });
  });
</script>

<style>
  .install-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  /* Ink slab (墨锭) — dark block, single sharp corner, vermilion action */
  .install-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 12px 22px;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--vermilion) 30%, transparent);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--vermilion) 18%, transparent);
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    font-size: 13px;
    letter-spacing: 0.5px;
  }
  .command {
    overflow-x: auto;
    white-space: nowrap;
    max-width: 250px;
  }
  .prompt {
    color: var(--vermilion);
  }
  .copy-btn {
    background: none;
    border: none;
    color: var(--vermilion);
    font-size: 12px;
    cursor: pointer;
    opacity: 0.85;
    font-family: "Noto Serif SC", serif;
    letter-spacing: 0.1em;
  }
  .copy-btn:hover {
    opacity: 1;
    text-shadow: 0 0 8px color-mix(in srgb, var(--vermilion) 50%, transparent);
  }
  /* Footnote-level platform switch — whisper, not a second hero element */
  .platform-switch {
    padding-left: 2px;
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    font-size: 10px;
    letter-spacing: 0.5px;
    color: var(--text-muted);
  }
  .platform-link {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .platform-link:hover,
  .platform-link.active {
    color: var(--vermilion);
  }
  .platform-sep {
    opacity: 0.5;
  }
  .preview-label {
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
