---
import { t, languages, langPath, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const currentPath = Astro.url.pathname.replace(`/${lang}`, '') || '/';
---

<nav class="nav">
  <a href={langPath(lang, '/')} class="nav-logo">{tr.nav.logo}</a>
  <div class="nav-right">
    <a href={langPath(lang, '/blog/')}>{tr.nav.blog}</a>
    <a href={langPath(lang, '/about/')}>{tr.nav.about}</a>
    <div class="lang-toggle">
      {languages.map((l) => (
        <a
          href={langPath(l, currentPath)}
          class:list={['lang-option', { active: l === lang }]}
        >
          {l === 'en' ? 'EN' : l === 'zh' ? '中' : '文'}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    position: relative;
    z-index: 10;
  }
  .nav-logo {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--text);
  }
  .nav-right {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .nav-right a {
    color: var(--text-dim);
    font-size: 13px;
  }
  .lang-toggle {
    display: flex;
    gap: 4px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 2px 4px;
  }
  .lang-option {
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 2px;
    color: var(--accent) !important;
  }
  .lang-option.active {
    background: var(--accent);
    color: var(--bg) !important;
  }
</style>
