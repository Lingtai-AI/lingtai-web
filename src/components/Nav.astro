---
import { t, languages, langPath, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const rawPath = Astro.url.pathname;
const langPrefix = `/${lang}`;
const isLangPrefixed = rawPath === langPrefix || rawPath.startsWith(`${langPrefix}/`);
const currentPath = isLangPrefixed ? rawPath.slice(langPrefix.length) || '/' : rawPath;
---

<nav class="nav">
  <a href={langPath(lang, '/')} class="nav-logo">
    {(
      <span class="logo-wen">
        <span>{lang === 'en' ? tr.nav.logo : '灵台'}</span>
        <svg class="logo-glyph" viewBox="0 0 200 200" aria-label="𢘐">
          <g fill="currentColor" stroke="currentColor" stroke-width="5" stroke-linejoin="round"><path d="M 50.0 16.0 L 53.0 18.0 L 50.0 19.8 L 50.0 183.0 L 38.0 189.0 L 38.0 14.0 Z M 71.3 174.4 L 120.0 174.4 L 120.0 105.6 L 90.5 105.6 L 90.5 101.6 L 139.5 101.6 L 149.5 91.6 L 161.5 101.6 L 161.5 105.6 L 132.0 105.6 L 132.0 174.4 L 159.3 174.4 L 169.3 164.4 L 181.3 174.4 L 181.3 178.4 L 71.3 178.4 Z M 165.4 90.2 L 159.3 83.9 L 153.4 76.9 L 147.8 69.4 L 142.4 61.3 L 137.3 52.6 L 132.5 43.3 L 128.1 33.3 L 127.67 32.16 L 127.3 33.0 L 121.6 44.4 L 115.6 55.0 L 109.2 65.0 L 102.5 74.4 L 95.4 83.0 L 88.0 90.9 L 80.1 98.0 L 71.9 104.4 L 63.3 109.8 L 62.2 108.3 L 69.5 101.5 L 76.4 94.2 L 83.1 86.5 L 89.5 78.2 L 95.6 69.4 L 101.4 60.1 L 106.9 50.1 L 112.0 39.6 L 116.9 28.5 L 121.4 16.7 L 121.41 16.70 L 121.9 15.3 L 132.6 21.1 L 134.7 24.0 L 131.03 24.63 L 129.59 27.86 L 131.8 31.4 L 137.6 40.3 L 143.4 48.7 L 149.2 56.5 L 155.1 63.7 L 161.1 70.2 L 167.1 76.1 L 173.2 81.4 L 179.4 86.0 L 185.7 90.1 L 189.5 92.6 L 178.4 101.1 L 171.8 96.0 Z M 15.2 101.4 L 12.8 97.5 L 13.7 93.1 L 15.1 91.5 L 16.6 89.4 L 18.1 86.8 L 19.5 83.8 L 20.9 80.3 L 22.4 76.4 L 23.8 72.2 L 25.2 67.5 L 26.6 62.4 L 28.0 56.9 L 29.7 57.0 L 29.8 62.8 L 29.9 68.2 L 29.7 73.2 L 29.3 77.9 L 28.8 82.3 L 28.1 86.4 L 27.2 90.2 L 26.2 93.7 L 25.0 96.9 L 23.6 99.9 L 19.7 102.3 Z M 64.2 78.3 L 63.5 75.6 L 62.6 72.7 L 61.6 69.9 L 60.4 66.9 L 59.0 63.8 L 57.4 60.7 L 55.8 57.4 L 53.7 54.3 L 55.0 53.1 L 57.9 55.7 L 60.8 58.1 L 63.5 60.6 L 66.0 63.3 L 68.3 66.0 L 70.3 68.7 L 72.2 71.6 L 73.9 74.5 L 75.4 77.5 L 76.7 80.5 L 76.1 85.0 L 72.5 87.9 L 67.9 87.2 L 65.1 83.6 L 64.8 81.0 Z"/></g>
        </svg>
      </span>
    )}
  </a>
  <div class="nav-right">
    <a href={langPath(lang, '/')}>{tr.nav.home}</a>
    <a href={langPath(lang, '/tutorial/')}>{tr.nav.tutorial}</a>
    <a href={langPath(lang, '/opportunities/')}>{tr.nav.opportunities}</a>
    <a href={langPath(lang, '/projects/')}>{tr.nav.projects}</a>
    <a href={langPath(lang, '/blog/')}>{tr.nav.blog}</a>
    <a href={langPath(lang, '/releases/')}>{tr.nav.releases}</a>
    <a href={langPath(lang, '/about/')}>{tr.nav.about}</a>
    <a
      href="https://github.com/Lingtai-AI/lingtai"
      target="_blank"
      rel="noopener noreferrer"
      class="nav-github"
      aria-label="GitHub repository"
    >
      <svg width="24" height="24" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2 .37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
    </a>
    <div class="lang-toggle">
      {languages.map((l) => (
        <a
          href={isLangPrefixed ? langPath(l, currentPath) : currentPath}
          class:list={['lang-option', { active: l === lang }]}
        >
          {l === 'en' ? 'EN' : l === 'zh' ? '中' : '文'}
        </a>
      ))}
    </div>
    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
      </svg>
    </button>
  </div>
</nav>

<script>
  const toggle = document.getElementById('theme-toggle')!;
  const root = document.documentElement;

  // Init from localStorage or system preference
  const stored = localStorage.getItem('theme');
  if (stored) {
    root.dataset.theme = stored;
  } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
    root.dataset.theme = 'dark';
  }

  toggle.addEventListener('click', () => {
    const isDark = root.dataset.theme === 'dark';
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    position: relative;
    z-index: 10;
  }
  .nav-logo {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--text);
  }
  .logo-wen {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .logo-glyph {
    width: 15px;
    height: 15px;
    vertical-align: middle;
    color: var(--text);
  }
  .nav-right {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .nav-right a {
    color: var(--text-dim);
    font-size: 13px;
    letter-spacing: 0.08em;
  }
  .nav-right a:hover {
    color: var(--vermilion);
  }
  .nav-github {
    display: inline-flex;
    align-items: center;
    color: var(--text-dim) !important;
    transition: color 0.15s;
  }
  .nav-github:hover {
    color: var(--accent-warm) !important;
  }
  .lang-toggle {
    display: flex;
    gap: 4px;
    border: 1px solid var(--vermilion);
    border-radius: 2px;
    padding: 2px 4px;
  }
  .lang-option {
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 1px;
    color: var(--vermilion) !important;
  }
  .lang-option.active {
    background: var(--vermilion);
    color: var(--seal-paper) !important;
  }
  .theme-toggle {
    background: none;
    border: none;
    padding: 2px;
    cursor: pointer;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }
  .theme-toggle:hover {
    color: var(--accent-warm);
  }
  /* Show sun in dark mode, moon in light mode */
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global([data-theme="dark"]) .icon-sun { display: block; }
  :global([data-theme="dark"]) .icon-moon { display: none; }

  /* Responsive: with the extra Tutorial link the single row overflows at tablet widths, not just phone widths.
     Root cause of the earlier clip: .nav-right is a flex row whose items default to
     min-width:auto, so it sizes to max-content and grows WIDER than the viewport; under
     justify-content:space-between the trailing links then sit past the right edge and get
     clipped. Fix (CSS-only, no hamburger): let the nav wrap, then force .nav-right to take
     the full row width and be allowed to shrink to the viewport (width/flex-basis 100% +
     min-width:0 + box-sizing:border-box), so its own flex-wrap can actually break the
     links onto multiple lines. nowrap is applied per-link (not to the row) so a single
     label never breaks mid-word. Desktop is untouched — all rules live inside the query. */
  @media (max-width: 1100px) {
    .nav {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 12px 0;
      padding: 16px 20px;
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }
    .nav-right {
      flex-wrap: wrap;
      flex-basis: 100%;
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
      gap: 10px 16px;
    }
    .nav-right > a {
      white-space: nowrap;
    }
  }
</style>
