---
interface Props {
  id: string;
  repo: string;
  name: string;
  description: string;
  author: string;
  authorUrl: string;
  ref: string;
  tags: string[];
  copyLabel: string;
  byLabel: string;
}

const { id, repo, name, description, author, authorUrl, ref, tags, copyLabel, byLabel } = Astro.props;
const repoUrl = `https://github.com/${repo}`;
const cloneCmd = ref === 'main'
  ? `git clone ${repoUrl}.git`
  : `git clone -b ${ref} ${repoUrl}.git`;
---

<article class="recipe-card" data-id={id}>
  <header>
    <h3 class="name serif">
      <a href={repoUrl} target="_blank" rel="noopener">{name}</a>
    </h3>
    <p class="byline">
      {byLabel} <a href={authorUrl} target="_blank" rel="noopener">{author}</a>
    </p>
  </header>

  <p class="description">{description}</p>

  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  )}

  <div class="install-pill">
    <span class="prompt">$</span>
    <span class="command">{cloneCmd}</span>
    <button class="copy-btn" data-command={cloneCmd}>{copyLabel}</button>
  </div>
</article>

<style>
  .recipe-card {
    background: var(--bg-alt);
    border: 1px solid rgba(125, 171, 143, 0.18);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 160ms ease, transform 160ms ease;
  }
  .recipe-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .name {
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 1px;
    color: var(--title-color);
  }
  .name a {
    color: inherit;
  }
  .name a:hover {
    color: var(--accent-warm);
  }
  .byline {
    font-size: 13px;
    color: var(--text-faint);
    letter-spacing: 0.5px;
  }
  .byline a {
    color: var(--text-dim);
  }
  .byline a:hover {
    color: var(--accent);
  }

  .description {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-dim);
    white-space: pre-wrap;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
  }
  .tag {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-faint);
    border: 1px solid rgba(138, 134, 128, 0.3);
    padding: 3px 9px;
    border-radius: 999px;
  }

  .install-pill {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 9px 14px;
    border-radius: 6px;
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    font-size: 12px;
  }
  .prompt {
    color: var(--text-faint);
  }
  .command {
    flex: 1;
    overflow-x: auto;
    white-space: nowrap;
  }
  .copy-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-size: 11px;
    cursor: pointer;
    opacity: 0.7;
    font-family: inherit;
  }
  .copy-btn:hover {
    opacity: 1;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.recipe-card .copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.command;
      if (!cmd) return;
      navigator.clipboard.writeText(cmd);
      const original = btn.textContent;
      btn.textContent = '✓';
      setTimeout(() => {
        btn.textContent = original;
      }, 1500);
    });
  });
</script>
