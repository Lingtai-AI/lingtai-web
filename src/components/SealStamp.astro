---
// 印章 — vermilion seal with the 𢘐 glyph (忄+全, "artificial heart").
// 白文 style: paper-white glyph knocked out of the red field. Decorative.
interface Props {
  size?: number;
  delay?: string;
}

const { size = 64, delay = '0s' } = Astro.props;
---

<span class="seal" style={`--seal-size:${size}px; animation-delay:${delay}`} aria-hidden="true">
  <svg viewBox="0 0 200 200">
    <g fill="currentColor" stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <path d="M 50.0 16.0 L 53.0 18.0 L 50.0 19.8 L 50.0 183.0 L 38.0 189.0 L 38.0 14.0 Z M 71.3 174.4 L 120.0 174.4 L 120.0 105.6 L 90.5 105.6 L 90.5 101.6 L 139.5 101.6 L 149.5 91.6 L 161.5 101.6 L 161.5 105.6 L 132.0 105.6 L 132.0 174.4 L 159.3 174.4 L 169.3 164.4 L 181.3 174.4 L 181.3 178.4 L 71.3 178.4 Z M 165.4 90.2 L 159.3 83.9 L 153.4 76.9 L 147.8 69.4 L 142.4 61.3 L 137.3 52.6 L 132.5 43.3 L 128.1 33.3 L 127.67 32.16 L 127.3 33.0 L 121.6 44.4 L 115.6 55.0 L 109.2 65.0 L 102.5 74.4 L 95.4 83.0 L 88.0 90.9 L 80.1 98.0 L 71.9 104.4 L 63.3 109.8 L 62.2 108.3 L 69.5 101.5 L 76.4 94.2 L 83.1 86.5 L 89.5 78.2 L 95.6 69.4 L 101.4 60.1 L 106.9 50.1 L 112.0 39.6 L 116.9 28.5 L 121.4 16.7 L 121.41 16.70 L 121.9 15.3 L 132.6 21.1 L 134.7 24.0 L 131.03 24.63 L 129.59 27.86 L 131.8 31.4 L 137.6 40.3 L 143.4 48.7 L 149.2 56.5 L 155.1 63.7 L 161.1 70.2 L 167.1 76.1 L 173.2 81.4 L 179.4 86.0 L 185.7 90.1 L 189.5 92.6 L 178.4 101.1 L 171.8 96.0 Z M 15.2 101.4 L 12.8 97.5 L 13.7 93.1 L 15.1 91.5 L 16.6 89.4 L 18.1 86.8 L 19.5 83.8 L 20.9 80.3 L 22.4 76.4 L 23.8 72.2 L 25.2 67.5 L 26.6 62.4 L 28.0 56.9 L 29.7 57.0 L 29.8 62.8 L 29.9 68.2 L 29.7 73.2 L 29.3 77.9 L 28.8 82.3 L 28.1 86.4 L 27.2 90.2 L 26.2 93.7 L 25.0 96.9 L 23.6 99.9 L 19.7 102.3 Z M 64.2 78.3 L 63.5 75.6 L 62.6 72.7 L 61.6 69.9 L 60.4 66.9 L 59.0 63.8 L 57.4 60.7 L 55.8 57.4 L 53.7 54.3 L 55.0 53.1 L 57.9 55.7 L 60.8 58.1 L 63.5 60.6 L 66.0 63.3 L 68.3 66.0 L 70.3 68.7 L 72.2 71.6 L 73.9 74.5 L 75.4 77.5 L 76.7 80.5 L 76.1 85.0 L 72.5 87.9 L 67.9 87.2 L 65.1 83.6 L 64.8 81.0 Z" />
    </g>
  </svg>
</span>

<style>
  .seal {
    width: var(--seal-size);
    height: var(--seal-size);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 28% 22%, rgba(0, 0, 0, 0.1), transparent 42%),
      radial-gradient(circle at 74% 80%, rgba(0, 0, 0, 0.12), transparent 38%),
      radial-gradient(circle at 60% 35%, rgba(255, 255, 255, 0.07), transparent 45%),
      var(--vermilion);
    color: var(--seal-paper);
    border-radius: 9%;
    transform: rotate(-2.5deg);
    box-shadow:
      inset 0 0 0 2px rgba(246, 239, 226, 0.14),
      inset 0 0 16px rgba(0, 0, 0, 0.22),
      0 1px 3px rgba(28, 26, 23, 0.18);
    animation: seal-stamp 0.55s cubic-bezier(0.18, 1.5, 0.4, 1) both;
  }

  .seal svg {
    width: 72%;
    height: 72%;
  }

  @keyframes seal-stamp {
    from {
      opacity: 0;
      transform: rotate(-2.5deg) scale(1.6);
    }
    55% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: rotate(-2.5deg) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seal {
      animation: none;
      opacity: 1;
    }
  }
</style>
