---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/translations';

interface Props {
  title: string;
  date: Date;
  lang: Lang;
  tags: string[];
}

const { title, date, lang, tags } = Astro.props;
---

<BaseLayout title={title} lang={lang}>
  <article class="blog-post">
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <time>{date.toISOString().slice(0, 10)}</time>
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 680px;
    margin: 60px auto;
    padding: 0 24px;
  }
  h1 {
    font-size: 28px;
    margin-bottom: 8px;
  }
  .meta {
    color: var(--text-faint);
    font-size: 13px;
    margin-bottom: 40px;
  }
  .tag {
    font-size: 11px;
    color: var(--accent);
    background: rgba(125, 171, 143, 0.1);
    padding: 2px 8px;
    border-radius: 3px;
    margin-left: 8px;
  }
  .prose {
    line-height: 1.8;
    color: var(--text);
  }
  .prose :global(h2) {
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .prose :global(p) {
    margin-bottom: 16px;
  }
  .prose :global(code) {
    background: var(--bg-alt);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    background: var(--code-bg);
    color: var(--code-text);
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 16px;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
    color: inherit;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 14px;
    line-height: 1.55;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid rgba(138, 134, 128, 0.28);
    padding: 8px 10px;
    vertical-align: top;
  }
  .prose :global(th) {
    background: var(--bg-alt);
    font-weight: 600;
  }
  .prose :global(details) {
    border: 1px solid rgba(138, 134, 128, 0.28);
    border-radius: 6px;
    padding: 12px 16px;
    margin: 16px 0;
    background: var(--bg-alt);
  }
  .prose :global(summary) {
    cursor: pointer;
    font-weight: 600;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 24px auto;
    border-radius: 4px;
  }
  .prose :global(p:has(> img)) {
    text-align: center;
  }
  .prose :global(p > img + em),
  .prose :global(img + em) {
    display: block;
    text-align: center;
    color: var(--text-faint);
    font-size: 13px;
    margin-top: -12px;
    margin-bottom: 24px;
  }

  /* Callouts (used by inline <div class="callout …"> in post markdown) */
  .prose :global(.callout) {
    border-radius: 6px;
    padding: 16px 20px;
    margin: 24px 0;
    line-height: 1.6;
  }
  .prose :global(.callout p) {
    margin: 0;
  }
  .prose :global(.callout p + p) {
    margin-top: 8px;
  }
  .prose :global(.callout ul) {
    margin: 6px 0 0;
    padding-left: 20px;
  }
  .prose :global(.callout-tldr) {
    background: var(--bg-alt);
    border-left: 3px solid var(--text-faint);
  }
  .prose :global(.callout-tldr strong:first-child) {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-faint);
    margin-bottom: 8px;
  }
  .prose :global(.callout-cta) {
    background: rgba(125, 171, 143, 0.08);
    border: 1px solid rgba(125, 171, 143, 0.35);
    text-align: center;
    font-size: 16px;
  }
  .prose :global(.callout-cta a) {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    font-size: 18px;
  }
  .prose :global(.callout-cta a:hover) {
    text-decoration: underline;
  }
  .prose :global(.callout-cta .subtle) {
    display: block;
    font-size: 13px;
    color: var(--text-faint);
    margin-top: 4px;
  }
</style>
