---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/translations';

interface Props {
  title: string;
  date: Date;
  lang: Lang;
  tags: string[];
}

const { title, date, lang, tags } = Astro.props;
---

<BaseLayout title={title} lang={lang}>
  <article class="blog-post">
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <time>{date.toISOString().slice(0, 10)}</time>
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 680px;
    margin: 60px auto;
    padding: 0 24px;
  }
  h1 {
    font-size: 28px;
    margin-bottom: 8px;
  }
  .meta {
    color: var(--text-faint);
    font-size: 13px;
    margin-bottom: 40px;
  }
  .tag {
    font-size: 11px;
    color: var(--accent);
    background: rgba(125, 171, 143, 0.1);
    padding: 2px 8px;
    border-radius: 3px;
    margin-left: 8px;
  }
  .prose {
    line-height: 1.8;
    color: var(--text);
  }
  .prose :global(h2) {
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .prose :global(p) {
    margin-bottom: 16px;
  }
  .prose :global(code) {
    background: var(--bg-alt);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    background: var(--code-bg);
    color: var(--code-text);
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 16px;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
    color: inherit;
  }
</style>
