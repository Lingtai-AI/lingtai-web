---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/about/');
const tr = t(lang as Lang);
---

<BaseLayout title={tr.nav.about} lang={lang as Lang}>
  <main class="about">
    <h1>{tr.about.heading}</h1>
    <div class="divider"></div>
    <p class="bio serif">{tr.about.bio}</p>

    <section class="project">
      <h2>{tr.about.projectHeading}</h2>
      <div class="divider"></div>
      {tr.about.projectBio.split('\n\n').map((p: string) => (
        <p class="bio serif">{p}</p>
      ))}
    </section>

    <section class="contact">
      <h2>{tr.about.contactHeading}</h2>
      <div class="divider"></div>
      <p class="bio">lingtai2026 at gmail.com</p>
    </section>
  </main>
</BaseLayout>

<style>
  .about {
    max-width: 680px;
    margin: 60px auto;
    padding: 0 24px;
  }
  h1 {
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--text);
  }
  .divider {
    width: 36px;
    height: 1px;
    background: var(--accent);
    margin: 16px 0;
  }
  .bio {
    font-size: 16px;
    line-height: 1.9;
    color: var(--text-dim);
  }
  .project {
    margin-top: 48px;
  }
  .project h2 {
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--text);
  }
  .project .bio {
    margin-top: 12px;
  }
  .contact {
    margin-top: 48px;
  }
  .contact a {
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.5px;
  }
  .contact a:hover {
    text-decoration: underline;
  }
</style>
