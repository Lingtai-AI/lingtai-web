---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/about/');
const tr = t(lang as Lang);
---

<BaseLayout title={tr.nav.about} lang={lang as Lang}>
  <main class="about">
    <h1>{tr.nav.about}</h1>
    <p class="placeholder">Coming soon.</p>
  </main>
</BaseLayout>

<style>
  .about {
    max-width: 680px;
    margin: 60px auto;
    padding: 0 24px;
  }
  h1 {
    font-size: 24px;
    margin-bottom: 24px;
  }
  .placeholder {
    color: var(--text-faint);
  }
</style>
