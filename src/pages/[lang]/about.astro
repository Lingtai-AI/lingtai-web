---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/about/');
const tr = t(lang as Lang);
---

<BaseLayout title={tr.nav.about} lang={lang as Lang}>
  <main class="about">
    <h1>{tr.about.heading}</h1>
    <div class="divider"></div>
    <p class="bio serif">{tr.about.bio}</p>
  </main>
</BaseLayout>

<style>
  .about {
    max-width: 680px;
    margin: 60px auto;
    padding: 0 24px;
  }
  h1 {
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--text);
  }
  .divider {
    width: 36px;
    height: 1px;
    background: var(--accent);
    margin: 16px 0;
  }
  .bio {
    font-size: 16px;
    line-height: 1.9;
    color: var(--text-dim);
  }
</style>
