---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AgoraBraille from '../../../components/AgoraBraille.astro';
import RecipeCard from '../../../components/RecipeCard.astro';
import { t, isValidLang, languages, type Lang } from '../../../i18n/translations';
import statsData from '../../../../agora-stats.json';

interface AgoraStat {
  stars?: number;
  reactionsTotal?: number;
}
const stats = (statsData as { stats: Record<string, AgoraStat> }).stats;

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/');
const tr = t(lang as Lang);

const entries = await getCollection('agora');
const sorted = entries
  .map((e) => e.data)
  .sort((a, b) => {
    if (a.featured !== b.featured) return a.featured ? -1 : 1;
    const ad = a.addedAt ? new Date(a.addedAt).getTime() : 0;
    const bd = b.addedAt ? new Date(b.addedAt).getTime() : 0;
    return bd - ad;
  });

const submitUrl = 'https://github.com/Lingtai-AI/lingtai-agora/issues/new?template=submit-recipe.yml';
const patronageCopy = {
  en: {
    heading: 'Skill patronage contract',
    body: 'Agora can also curate repo-backed skills: authors keep ownership, publish under an open license, and declare optional tip links. LingTai provides the contract, discovery, and post-use invitation — not payment custody.',
    button: 'Read the contract',
  },
  zh: {
    heading: 'Skill 打赏契约',
    body: 'Agora 也可以精选 repo-backed skill：作者保留所有权，以开源许可证发布，并声明可选收款方式。灵台只提供契约、发现与用后提示，不托管支付。',
    button: '查看契约',
  },
  wen: {
    heading: '术之谢约',
    body: 'Agora 亦可择有阁之术：作者有其术，以明许开源，列谢门。灵台立约、示之、用后提醒，不托财。',
    button: '阅其约',
  },
}[lang as Lang];
---

<BaseLayout title={tr.agora.title} lang={lang as Lang}>
  <AgoraBraille />

  <main class="agora">
    <header class="agora-header">
      <h1 class="title serif">{tr.agora.title}</h1>
      <div class="divider"></div>
      <p class="tagline">{tr.agora.tagline}</p>
      <p class="intro">{tr.agora.intro}</p>
    </header>

    {sorted.length === 0 ? (
      <p class="empty">{tr.agora.empty}</p>
    ) : (
      <section class="grid">
        {sorted.map((entry) => (
          <RecipeCard
            id={entry.id}
            repo={entry.repo}
            name={entry.name}
            description={entry.description}
            author={entry.author}
            authorUrl={entry.authorUrl}
            ref={entry.ref}
            tags={entry.tags}
            stars={stats[entry.id]?.stars}
            reactionsTotal={stats[entry.id]?.reactionsTotal}
            copyLabel={tr.agora.copy}
            byLabel={tr.agora.by}
            viewLabel={tr.agora.view}
            detailHref={`/${lang}/agora/${entry.id}/`}
          />
        ))}
      </section>
    )}

    <section class="submit patronage">
      <h2 class="serif">{patronageCopy.heading}</h2>
      <p>{patronageCopy.body}</p>
      <a class="submit-button" href={`/${lang}/agora/skill-patronage/`}>
        {patronageCopy.button}
      </a>
    </section>

    <section class="submit">
      <h2 class="serif">{tr.agora.submitHeading}</h2>
      <p>{tr.agora.submitBody}</p>
      <a class="submit-button" href={submitUrl} target="_blank" rel="noopener">
        {tr.agora.submitButton}
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .agora {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 24px 80px;
    position: relative;
    z-index: 1;
  }
  .agora-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .title {
    font-size: 40px;
    font-weight: 300;
    letter-spacing: 6px;
    color: var(--title-color);
  }
  .divider {
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin: 18px auto;
  }
  .tagline {
    color: var(--text-faint);
    font-size: 14px;
    letter-spacing: 2px;
  }
  .intro {
    margin: 18px auto 0;
    max-width: 560px;
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty {
    text-align: center;
    color: var(--text-faint);
    padding: 60px 0;
    font-size: 15px;
    letter-spacing: 1px;
  }

  .submit {
    margin-top: 64px;
    padding: 36px 24px;
    border-top: 1px solid rgba(125, 171, 143, 0.18);
    text-align: center;
  }
  .submit h2 {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--text);
    margin-bottom: 10px;
  }
  .submit p {
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 22px;
  }
  .submit-button {
    display: inline-block;
    padding: 10px 24px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: background 160ms ease, color 160ms ease;
  }
  .submit.patronage {
    margin-top: 56px;
    border: 1px solid rgba(125, 171, 143, 0.18);
    border-radius: 24px;
    background: rgba(125, 171, 143, 0.05);
  }
  .submit-button:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
