---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, isValidLang, languages, type Lang } from '../../../i18n/translations';
import { postsForLang } from '../../../lib/posts';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/blog/');
const tr = t(lang as Lang);

const entries = (await postsForLang(lang as Lang))
  .sort((a, b) => b.post.data.date.valueOf() - a.post.data.date.valueOf());
---

<BaseLayout title={tr.nav.blog} lang={lang as Lang}>
  <main class="blog-list">
    <h1>{tr.nav.blog}</h1>
    {entries.length === 0 && <p class="empty">No posts yet.</p>}
    <ul>
      {entries.map(({ slug, post, isFallback }) => (
        <li>
          <a href={`/${lang}/blog/${slug}/`}>
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
          </a>
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
          {isFallback && <span class="fallback">en</span>}
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .blog-list {
    max-width: 680px;
    margin: 60px auto;
    padding: 0 24px;
  }
  h1 {
    font-size: 24px;
    margin-bottom: 32px;
    color: var(--text);
  }
  .empty {
    color: var(--text-faint);
  }
  ul {
    list-style: none;
  }
  li {
    margin-bottom: 16px;
  }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--text);
  }
  li a:hover .post-title {
    color: var(--accent);
  }
  .post-date {
    color: var(--text-faint);
    font-size: 13px;
  }
  .tag {
    font-size: 11px;
    color: var(--accent);
    background: rgba(125, 171, 143, 0.1);
    padding: 2px 8px;
    border-radius: 3px;
    margin-left: 8px;
  }
  .fallback {
    font-size: 10px;
    color: var(--text-faint);
    border: 1px solid var(--text-faint);
    padding: 1px 6px;
    border-radius: 3px;
    margin-left: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
