---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrailleBackground from '../../components/BrailleBackground.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import { t, isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/');
const tr = t(lang as Lang);
---

<BaseLayout title={tr.hero.title} lang={lang as Lang}>
  <BrailleBackground lang={lang as Lang} />

  <main class="hero">
    <h1 class="title serif">{tr.hero.title}</h1>
    <p class="subtitle">{tr.hero.subtitle}</p>

    <div class="divider"></div>

    <p class="poem">{tr.hero.poem1}</p>
    <p class="poem">{tr.hero.poem2}</p>

    <div class="install">
      <InstallCommand copyLabel={tr.hero.copy} />
    </div>

    <div class="links">
      <a href="https://github.com/huangzesen/lingtai">GitHub</a>
      <span class="dot">·</span>
      <a href="https://www.npmjs.com/package/lingtai">npm</a>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 80px);
    text-align: center;
    position: relative;
    z-index: 1;
    padding: 0 40px;
  }
  .title {
    font-size: 48px;
    font-weight: 300;
    letter-spacing: 6px;
    color: var(--text);
  }
  .subtitle {
    font-size: 18px;
    color: var(--text-faint);
    font-weight: 300;
    letter-spacing: 3px;
    margin-top: 4px;
  }
  .divider {
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin: 20px 0;
  }
  .poem {
    color: var(--text-faint);
    font-size: 14px;
    letter-spacing: 1px;
    line-height: 1.8;
  }
  .install {
    margin-top: 36px;
  }
  .links {
    margin-top: 16px;
    font-size: 12px;
  }
  .links a {
    color: var(--accent);
  }
  .dot {
    color: var(--text-faint);
    margin: 0 4px;
  }
</style>
