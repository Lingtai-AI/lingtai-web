---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import NetworkCanvas from '../../components/NetworkCanvas.astro';
import OaaSCanvas from '../../components/OaaSCanvas.astro';
import CelestialChart from '../../components/CelestialChart.astro';
import Handscroll from '../../components/Handscroll.astro';
import SealStamp from '../../components/SealStamp.astro';
import { t, isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/');
const tr = t(lang as Lang);

const isCJK = lang !== 'en';
// 「灵台方寸山 斜月三星洞」→ two columns per poem line, four columns total.
// In vertical-rl flow the DOM order renders right-to-left — classical reading order.
const poemColumns = isCJK
  ? [...tr.hero.poem1.split(' '), ...tr.hero.poem2.split(' ')]
  : [];
---

<BaseLayout title={tr.hero.title} lang={lang as Lang} night>
  <header class="sky night">
    <CelestialChart lang={lang as Lang} />

    <div class="hero">
      {isCJK ? (
        <div class="scroll-composition">
          <h1 class="title-v serif ink-reveal" style="animation-delay:0.5s"><span class="gilt">{tr.hero.title}</span></h1>
          <div class="poem-cols">
            {poemColumns.map((col, i) => (
              <span class="poem-col serif ink-reveal" style={`animation-delay:${1.2 + i * 0.22}s`}>{col}</span>
            ))}
          </div>
          <div class="colophon ink-reveal" style="animation-delay:2.3s">
            <span class="subtitle-v">{tr.hero.subtitle}</span>
            <SealStamp size={58} delay="2.6s" />
          </div>
        </div>
      ) : (
        <div class="latin-composition">
          <div class="title-row">
            <h1 class="title-en latin-display ink-reveal" style="animation-delay:0.5s"><span class="gilt">{tr.hero.title}</span></h1>
            <SealStamp size={56} delay="2.3s" />
          </div>
          <p class="subtitle-en latin-display ink-reveal" style="animation-delay:1.1s">{tr.hero.subtitle}</p>
          <div class="poem-en">
            <p class="poem-line latin-display ink-reveal" style="animation-delay:1.5s">{tr.hero.poem1}</p>
            <p class="poem-line latin-display ink-reveal" style="animation-delay:1.75s">{tr.hero.poem2}</p>
          </div>
        </div>
      )}

      <div class="install ink-reveal" style="animation-delay:2.8s">
        <InstallCommand copyLabel={tr.hero.copy} showWindows />
        <a class="repo-link" href="https://github.com/Lingtai-AI/lingtai">GitHub</a>
      </div>

      <p class="sky-hint ink-reveal" style="animation-delay:4.2s">{tr.hero.hint}</p>
    </div>

    <!-- 方寸山 — ridges against the stars; the nearest ridge is the paper itself -->
    <svg class="ridges" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="horizon-gilt" x1="0" x2="1">
          <stop offset="0" stop-color="#d8b468" stop-opacity="0" />
          <stop offset="0.3" stop-color="#f4e2a8" stop-opacity="0.9" />
          <stop offset="0.55" stop-color="#d8b468" stop-opacity="0.55" />
          <stop offset="0.8" stop-color="#f4e2a8" stop-opacity="0.85" />
          <stop offset="1" stop-color="#d8b468" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path class="ridge far" d="M0,150 Q90,104 200,128 T430,96 Q520,70 610,110 T840,92 Q950,58 1060,104 T1290,96 Q1370,84 1440,108 L1440,300 L0,300 Z" />
      <path class="ridge mid" d="M0,206 Q140,150 300,186 T620,170 Q760,128 900,176 T1200,168 Q1330,150 1440,180 L1440,300 L0,300 Z" />
      <path class="ridge near" d="M0,258 Q200,214 420,244 T840,232 Q1010,204 1170,238 T1440,246 L1440,300 L0,300 Z" />
      <path class="horizon" d="M0,258 Q200,214 420,244 T840,232 Q1010,204 1170,238 T1440,246" />
    </svg>

    <div class="scroll-hint" aria-hidden="true">
      <span class="thread"></span>
      <span class="drop"></span>
    </div>
  </header>

  <Handscroll heading={tr.meanings.heading} body={tr.about.projectBio} items={tr.meanings.items} cjk={isCJK} />

  <NetworkCanvas line1a={tr.network.line1a} line1b={tr.network.line1b} line2={tr.network.line2} line3={tr.network.line3} quickstart="lingtai-tui" quickstartLabel={tr.network.quickstartLabel} copyLabel={tr.hero.copy} />

  <OaaSCanvas line1={tr.oaas.line1} line2={tr.oaas.line2} manifesto={tr.oaas.manifesto} />
</BaseLayout>

<style>
  /* ── 磁青 night sky ─────────────────────────────────────────────── */
  .sky {
    position: relative;
    z-index: 1;
    min-height: max(100vh, 640px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 50% 46%, #1b2e60 0%, transparent 70%),
      radial-gradient(ellipse 120% 90% at 50% 40%, var(--night) 0%, var(--night-deep) 100%);
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    z-index: 2;
    padding: 96px 40px 20vh;
    pointer-events: none;
  }
  .hero :global(a), .hero :global(button), .hero .install { pointer-events: auto; }

  /* A pool of deeper night behind the title so the gold reads over the chart */
  .hero::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(760px, 110vw);
    height: min(620px, 90vh);
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(6, 12, 28, 0.62), rgba(6, 12, 28, 0.25) 60%, transparent);
    z-index: -1;
  }

  /* Gilded title: the light sweeps across the leaf once, as it is laid down */
  .title-v .gilt,
  .title-en .gilt {
    display: inline-block;
    animation: gilt-sweep 3.4s cubic-bezier(0.3, 0.1, 0.2, 1) 1.2s both;
  }
  .title-v,
  .title-en {
    filter: drop-shadow(0 0 34px rgba(216, 180, 104, 0.28));
  }
  .title-v.ink-reveal,
  .title-en.ink-reveal {
    animation-name: ink-reveal-glow;
  }

  @keyframes gilt-sweep {
    from { background-position: 100% 0; }
    to { background-position: 0% 0; }
  }
  @keyframes ink-reveal-glow {
    from { opacity: 0; filter: blur(10px) drop-shadow(0 0 0 rgba(216, 180, 104, 0)); transform: translateY(10px); }
    to { opacity: 1; filter: blur(0) drop-shadow(0 0 34px rgba(216, 180, 104, 0.28)); transform: translateY(0); }
  }

  /* ── 竖排 hanging-scroll composition (zh / wen) ─────────────────────
     vertical-rl: block flow runs right→left, so DOM order = classical
     reading order. flex-direction:column follows the block axis. */
  .scroll-composition {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }

  .title-v {
    font-size: clamp(96px, 19vh, 184px);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .poem-cols {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vw, 22px);
    padding-block-start: 0.4em;
  }

  .poem-col {
    font-size: clamp(17px, 2.6vh, 23px);
    font-weight: 300;
    letter-spacing: 0.42em;
    color: var(--text-dim);
    line-height: 1;
  }

  .colophon {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-block-start: 0.6em;
  }

  .subtitle-v {
    font-size: 14px;
    letter-spacing: 0.45em;
    color: var(--gold);
    opacity: 0.8;
  }

  /* ── Latin composition (en) ───────────────────────────────────── */
  .title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }

  .title-en {
    font-size: clamp(84px, 15vw, 196px);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 0.95;
  }

  .subtitle-en {
    margin-top: 10px;
    font-size: 22px;
    font-style: italic;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    color: var(--gold);
  }

  .poem-en {
    margin-top: 26px;
  }

  .poem-line {
    font-style: italic;
    font-size: clamp(19px, 1.7vw, 23px);
    letter-spacing: 0.05em;
    color: var(--text-dim);
    line-height: 1.85;
  }

  /* ── Install, set in a gold-edged slab of night ────────────────── */
  .install {
    margin-top: clamp(36px, 6vh, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .install :global(.install-pill) {
    background: rgba(5, 10, 26, 0.7);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(216, 180, 104, 0.42);
    box-shadow: 0 0 0 4px rgba(216, 180, 104, 0.06), 0 18px 50px -18px rgba(0, 0, 0, 0.8);
    padding: 14px 24px;
  }
  .install :global(.prompt) { color: var(--gold); }
  .install :global(.copy-btn) { color: var(--gold-hi); }
  .install :global(.platform-switch) { color: var(--text-faint); }
  .install :global(.platform-link:hover),
  .install :global(.platform-link.active) { color: var(--gold); }

  .repo-link {
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--gold);
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(216, 180, 104, 0.35);
  }
  .repo-link:hover { color: var(--gold-hi); border-color: var(--gold-hi); }

  .sky-hint {
    margin-top: 22px;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  /* ── Ridges ─────────────────────────────────────────────────────── */
  .ridges {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(150px, 24vh, 260px);
    z-index: 1;
    pointer-events: none;
  }
  .ridge.far { fill: #18264d; opacity: 0.85; }
  .ridge.mid { fill: #0a1330; }
  .ridge.near { fill: var(--page-bg); }
  .horizon {
    fill: none;
    stroke: url(#horizon-gilt);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  /* ── Scroll hint — a gold drop sliding down a thread ───────────── */
  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 46px;
    z-index: 3;
  }
  .thread {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, var(--gold));
    opacity: 0.6;
  }
  .drop {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--vermilion);
    animation: drop-fall 2.4s ease-in infinite;
  }
  @keyframes drop-fall {
    0% { top: 0; opacity: 0; }
    25% { opacity: 0.9; }
    78% { top: 41px; opacity: 0.9; }
    100% { top: 41px; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drop { animation: none; opacity: 0; }
    .title-v .gilt, .title-en .gilt { animation: none; background-position: 30% 0; }
    .title-v.ink-reveal, .title-en.ink-reveal { animation: none; opacity: 1; }
  }

  @media (max-width: 720px) {
    .hero { padding: 150px 16px 26vh; }
    .scroll-composition { gap: 26px; }
    .title-v { font-size: clamp(84px, 24vw, 128px); }
    .poem-col { letter-spacing: 0.3em; }
    .title-row { gap: 14px; }
    .title-row :global(.seal) { --seal-size: 40px !important; }
  }
</style>
