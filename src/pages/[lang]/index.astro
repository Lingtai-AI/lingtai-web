---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrailleBackground from '../../components/BrailleBackground.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import NetworkCanvas from '../../components/NetworkCanvas.astro';
import OaaSCanvas from '../../components/OaaSCanvas.astro';
import InkMountains from '../../components/InkMountains.astro';
import SealStamp from '../../components/SealStamp.astro';
import { t, isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/');
const tr = t(lang as Lang);

const isCJK = lang !== 'en';
// 「灵台方寸山 斜月三星洞」→ two columns per poem line, four columns total.
// In vertical-rl flow the DOM order renders right-to-left — classical reading order.
const poemColumns = isCJK
  ? [...tr.hero.poem1.split(' '), ...tr.hero.poem2.split(' ')]
  : [];
---

<BaseLayout title={tr.hero.title} lang={lang as Lang}>
  <BrailleBackground lang={lang as Lang} />

  <main class="hero">
    <InkMountains />

    {isCJK ? (
      <div class="scroll-composition">
        <h1 class="title-v serif ink-reveal" style="animation-delay:0.1s">{tr.hero.title}</h1>
        <div class="poem-cols">
          {poemColumns.map((col, i) => (
            <span class="poem-col serif ink-reveal" style={`animation-delay:${0.7 + i * 0.22}s`}>{col}</span>
          ))}
        </div>
        <div class="colophon ink-reveal" style="animation-delay:1.8s">
          <span class="subtitle-v">{tr.hero.subtitle}</span>
          <SealStamp size={58} delay="2.1s" />
        </div>
      </div>
    ) : (
      <div class="latin-composition">
        <div class="title-row">
          <h1 class="title-en latin-display ink-reveal" style="animation-delay:0.1s">{tr.hero.title}</h1>
          <SealStamp size={52} delay="1.8s" />
        </div>
        <p class="subtitle-en ink-reveal" style="animation-delay:0.6s">{tr.hero.subtitle}</p>
        <div class="poem-en">
          <p class="poem-line latin-display ink-reveal" style="animation-delay:1s">{tr.hero.poem1}</p>
          <p class="poem-line latin-display ink-reveal" style="animation-delay:1.25s">{tr.hero.poem2}</p>
        </div>
      </div>
    )}

    <div class="install ink-reveal" style="animation-delay:2.3s">
      <InstallCommand copyLabel={tr.hero.copy} caption={tr.hero.installCaption} hint={tr.hero.installHint} />
      <div class="links">
        <a href="https://github.com/Lingtai-AI/lingtai">GitHub</a>
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true">
      <span class="ink-thread"></span>
      <span class="ink-drop"></span>
    </div>
  </main>

  <NetworkCanvas line1a={tr.network.line1a} line1b={tr.network.line1b} line2={tr.network.line2} line3={tr.network.line3} quickstart="lingtai-tui" quickstartLabel={tr.network.quickstartLabel} copyLabel={tr.hero.copy} />

  <OaaSCanvas line1={tr.oaas.line1} line2={tr.oaas.line2} manifesto={tr.oaas.manifesto} />
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 80px);
    text-align: center;
    position: relative;
    z-index: 1;
    padding: 0 40px;
  }

  /* ── 竖排 hanging-scroll composition (zh / wen) ─────────────────────
     vertical-rl: block flow runs right→left, so DOM order = classical
     reading order. flex-direction:column follows the block axis. */
  .scroll-composition {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
    position: relative;
    z-index: 1;
  }

  .title-v {
    font-size: clamp(96px, 19vh, 164px);
    font-weight: 250;
    letter-spacing: 0.12em;
    line-height: 1;
    color: var(--title-color);
  }

  .poem-cols {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vw, 22px);
    padding-block-start: 0.4em;
  }

  .poem-col {
    font-size: clamp(17px, 2.6vh, 23px);
    font-weight: 300;
    letter-spacing: 0.42em;
    color: var(--text-dim);
    line-height: 1;
  }

  .colophon {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-block-start: 0.6em;
  }

  .subtitle-v {
    font-size: 13px;
    letter-spacing: 0.45em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  /* ── Latin composition (en) ───────────────────────────────────── */
  .latin-composition {
    position: relative;
    z-index: 1;
  }

  .title-row {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 26px;
  }

  .title-en {
    font-size: clamp(78px, 13vw, 138px);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--title-color);
  }

  .subtitle-en {
    margin-top: 18px;
    font-size: 14px;
    letter-spacing: 0.55em;
    text-indent: 0.55em; /* re-center: tracking adds trailing space */
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .poem-en {
    margin-top: 34px;
  }

  .poem-line {
    font-style: italic;
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    line-height: 1.9;
  }

  /* ── Shared ───────────────────────────────────────────────────── */
  .install {
    margin-top: clamp(36px, 6vh, 60px);
    position: relative;
    z-index: 1;
  }

  .links {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.2em;
  }

  /* Scroll hint — an ink drop sliding down a hanging thread */
  .scroll-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 44px;
    z-index: 1;
  }

  .ink-thread {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, var(--text-faint));
    opacity: 0.5;
  }

  .ink-drop {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--vermilion);
    animation: ink-fall 2.4s ease-in infinite;
  }

  @keyframes ink-fall {
    0% { top: 0; opacity: 0; }
    25% { opacity: 0.9; }
    78% { top: 39px; opacity: 0.9; }
    100% { top: 39px; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-drop { animation: none; opacity: 0; }
  }

  @media (max-width: 720px) {
    .hero { padding: 0 20px; }
    .scroll-composition { gap: 26px; }
    .title-v { font-size: clamp(72px, 19vw, 110px); }
    .poem-col { letter-spacing: 0.3em; }
    .title-row { gap: 16px; }
  }
</style>
