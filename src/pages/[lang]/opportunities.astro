---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { opportunities } from '../../data/opportunities';
import { isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/opportunities/');
const currentLang = lang as Lang;
const isEnglish = currentLang === 'en';
const local = <T,>(en: T, zh: T) => (isEnglish ? en : zh);

const page = {
  title: local('Opportunities', '研究机会'),
  eyebrow: local('LingTai Opportunities', '灵台研究机会'),
  hero: local('Open problems for agent networks', 'Agent 网络的开放题目'),
  subtitle: local(
    "Small, sponsor-backed research directions where LingTai's agent-network architecture can become a concrete experiment.",
    '这里收集适合用灵台做成 demo、论文式实验或长期合作的开放题目。',
  ),
  view: local('View opportunities', '查看机会'),
  github: local('LingTai on GitHub ↗', 'LingTai GitHub ↗'),
  nowOpen: local('Now open', '开放中'),
  directions: local('Research directions', '研究方向'),
  location: local('Location', '地点'),
  goodFit: local('Good fit', '适合背景'),
  why: local('Why this matters', '为什么重要'),
  questions: local('Research questions', '研究问题'),
  design: local('Possible LingTai design', '可能的 LingTai 设计'),
  outputs: local('Expected outputs', '预期产出'),
  people: local('People behind this opportunity', '相关人员'),
};
---

<BaseLayout title={page.title} lang={currentLang}>
  <main class="opportunities-page">
    <section class="hero" data-snap>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="serif">{page.hero}</h1>
      <p class="subtitle">{page.subtitle}</p>
      <div class="hero-actions">
        <a class="primary" href="#open">{page.view}</a>
        <a class="secondary" href="https://github.com/Lingtai-AI/lingtai" target="_blank" rel="noopener noreferrer">{page.github}</a>
      </div>
    </section>

    <section id="open" class="list-section" data-snap>
      <div class="section-heading">
        <p class="eyebrow">{page.nowOpen}</p>
        <h2 class="serif">{page.directions}</h2>
      </div>

      <div class="opportunity-list">
        {opportunities.map((opportunity) => (
          <article class="opportunity-card" id={opportunity.id}>
            <div class="card-top">
              <span class="status">{opportunity.status}</span>
              <span class="sponsor">{opportunity.sponsor}</span>
            </div>

            <h3 class="serif">{local(opportunity.title, opportunity.titleZh)}</h3>
            <p class="tagline">{local(opportunity.tagline, opportunity.taglineZh)}</p>

            <div class="meta-grid">
              <div>
                <strong>{page.location}</strong>
                <span>{opportunity.location}</span>
              </div>
              <div>
                <strong>{page.goodFit}</strong>
                <span>{local(opportunity.backgrounds, opportunity.backgroundsZh).slice(0, 2).join(' · ')}</span>
              </div>
            </div>

            <div class="body-grid">
              <section>
                <h4>{page.why}</h4>
                <p>{local(opportunity.summary, opportunity.summaryZh)}</p>
              </section>

              <section>
                <h4>{page.questions}</h4>
                <ul>
                  {local(opportunity.researchQuestions, opportunity.researchQuestionsZh).map((item) => (
                    <li><span>{item}</span></li>
                  ))}
                </ul>
              </section>

              <section>
                <h4>{page.design}</h4>
                <ul>
                  {local(opportunity.methods, opportunity.methodsZh).map((item) => (
                    <li><span>{item}</span></li>
                  ))}
                </ul>
              </section>

              <section>
                <h4>{page.outputs}</h4>
                <ul>
                  {local(opportunity.outputs, opportunity.outputsZh).map((item) => (
                    <li><span>{item}</span></li>
                  ))}
                </ul>
              </section>
            </div>

            <section class="people-section">
              <h4>{page.people}</h4>
              <div class="people-grid">
                {opportunity.people.map((person) => (
                  <article class="person-card">
                    <div class="person-heading">
                      <div>
                        <strong>{local(person.name, person.nameZh)}</strong>
                      </div>
                      <em>{local(person.role, person.roleZh)}</em>
                    </div>
                    <p>{local(person.profile, person.profileZh)}</p>
                    <div class="person-links">
                      {person.links.map((link) => (
                        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </section>

            <div class="notes">
              {local(opportunity.notes, opportunity.notesZh).map((item) => (
                <p><span>{item}</span></p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .opportunities-page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px 96px;
  }

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 48px 0 72px;
  }

  .eyebrow {
    color: var(--text-faint);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  h1 {
    color: var(--title-color);
    font-size: clamp(40px, 8vw, 78px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: 2px;
    max-width: 920px;
  }

  .subtitle {
    max-width: 720px;
    color: var(--text-dim);
    font-size: 17px;
    line-height: 1.8;
    margin-top: 28px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }

  .primary,
  .secondary {
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 13px;
    letter-spacing: 0.5px;
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }

  .secondary {
    color: var(--accent);
  }

  .section-heading {
    text-align: center;
    margin-bottom: 36px;
  }

  .section-heading h2 {
    color: var(--title-color);
    font-weight: 300;
    font-size: 34px;
    letter-spacing: 3px;
  }

  .opportunity-list {
    display: grid;
    gap: 28px;
  }

  .opportunity-card {
    border: 1px solid rgba(138, 134, 128, 0.22);
    border-radius: 28px;
    padding: clamp(24px, 4vw, 44px);
    background: linear-gradient(135deg, rgba(125, 171, 143, 0.08), rgba(196, 154, 108, 0.06));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.06);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .status {
    color: var(--bg);
    background: var(--accent);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .sponsor {
    color: var(--text-faint);
    font-size: 13px;
  }

  h3 {
    color: var(--title-color);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 300;
    line-height: 1.12;
    margin-bottom: 16px;
  }

  .tagline {
    color: var(--text-dim);
    font-size: 16px;
    line-height: 1.7;
  }

  small {
    color: var(--text-faint);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 30px 0;
  }

  .meta-grid div {
    border-top: 1px solid rgba(138, 134, 128, 0.2);
    padding-top: 14px;
  }

  .meta-grid strong {
    display: block;
    color: var(--accent-warm);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  .meta-grid span {
    color: var(--text-dim);
    font-size: 14px;
  }

  .body-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  h4 {
    color: var(--title-color);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  section p,
  li {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.75;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 12px;
  }

  li {
    position: relative;
    padding-left: 18px;
  }

  li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent-warm);
  }

  li span,
  .notes span {
    display: block;
  }

  .people-section {
    border-top: 1px solid rgba(138, 134, 128, 0.2);
    margin-top: 34px;
    padding-top: 24px;
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .person-card {
    border: 1px solid rgba(138, 134, 128, 0.18);
    border-radius: 20px;
    padding: 20px;
    background: rgba(245, 240, 232, 0.42);
  }

  :global([data-theme="dark"]) .person-card {
    background: rgba(14, 14, 20, 0.26);
  }

  .person-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .person-heading strong,
  .person-heading em {
    display: block;
  }

  .person-heading strong {
    color: var(--title-color);
    font-size: 20px;
    font-family: Georgia, "Times New Roman", "Songti SC", "SimSun", serif;
    font-weight: 300;
  }

  .person-heading em {
    color: var(--accent-warm);
    font-style: normal;
    font-size: 12px;
    text-align: right;
    max-width: 190px;
  }

  .person-card p {
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.75;
    margin-bottom: 10px;
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .person-links a {
    border: 1px solid rgba(125, 171, 143, 0.45);
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 12px;
    color: var(--accent);
  }

  .notes {
    border-top: 1px solid rgba(138, 134, 128, 0.2);
    margin-top: 30px;
    padding-top: 18px;
    display: grid;
    gap: 10px;
  }

  .notes p {
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .meta-grid,
    .body-grid,
    .people-grid {
      grid-template-columns: 1fr;
    }

    .opportunities-page {
      padding-inline: 18px;
    }
  }
</style>
