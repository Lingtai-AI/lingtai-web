---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, isValidLang, languages, type Lang } from '../../i18n/translations';
import { projects, pick } from '../../data/projects';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/projects/');
const currentLang = lang as Lang;
const tr = t(currentLang);

const sorted = [...projects].sort((a, b) => {
  if (!!a.featured !== !!b.featured) return a.featured ? -1 : 1;
  return new Date(b.addedAt).getTime() - new Date(a.addedAt).getTime();
});
---

<BaseLayout title={tr.projects.title} lang={currentLang}>
  <main class="projects">
    <header class="projects-header">
      <p class="eyebrow">{tr.projects.eyebrow}</p>
      <h1 class="title serif">{tr.projects.hero}</h1>
      <div class="divider"></div>
      <p class="intro">{tr.projects.subtitle}</p>
    </header>

    {sorted.length === 0 ? (
      <p class="empty">{tr.projects.empty}</p>
    ) : (
      <section class="grid">
        {sorted.map((project) => (
          <article class="project-card">
            <header class="card-head">
              <h2 class="serif">{pick(project.name, currentLang)}</h2>
              <p class="tagline">{pick(project.tagline, currentLang)}</p>
            </header>

            <p class="description">{pick(project.description, currentLang)}</p>

            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{pick(tag, currentLang)}</span>
              ))}
            </div>

            <a class="visit" href={project.url} target="_blank" rel="noopener noreferrer">
              <span class="visit-label">{tr.projects.visit}</span>
              <span class="visit-url">{project.urlLabel}</span>
            </a>
          </article>
        ))}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .projects {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 24px 88px;
    position: relative;
    z-index: 1;
  }
  .projects-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .eyebrow {
    color: var(--text-faint);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .title {
    font-size: clamp(32px, 6vw, 46px);
    font-weight: 300;
    letter-spacing: 4px;
    color: var(--title-color);
    line-height: 1.15;
  }
  .divider {
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin: 22px auto;
  }
  .intro {
    margin: 0 auto;
    max-width: 620px;
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.8;
  }

  .grid {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(138, 134, 128, 0.22);
    border-radius: 24px;
    padding: clamp(24px, 3.4vw, 36px);
    background: linear-gradient(135deg, rgba(125, 171, 143, 0.08), rgba(196, 154, 108, 0.06));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.06);
  }

  .card-head h2 {
    color: var(--title-color);
    font-size: 26px;
    font-weight: 300;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }
  .tagline {
    color: var(--accent-warm);
    font-size: 14px;
    line-height: 1.65;
  }
  .description {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.8;
    margin-top: 18px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .tag {
    border: 1px solid rgba(125, 171, 143, 0.4);
    border-radius: 999px;
    padding: 4px 11px;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--accent);
  }

  .visit {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .visit-label {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 1.5px;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease;
  }
  .visit:hover .visit-label {
    border-color: var(--accent);
  }
  .visit-url {
    color: var(--text-faint);
    font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .empty {
    text-align: center;
    color: var(--text-faint);
    padding: 60px 0;
    font-size: 15px;
    letter-spacing: 1px;
  }

  @media (max-width: 760px) {
    .projects {
      padding-inline: 18px;
    }
  }
</style>
