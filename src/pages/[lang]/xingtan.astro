---
import BaseLayout from '../../layouts/BaseLayout.astro';
import XingtanLanding from '../../components/XingtanLanding.astro';
import { isValidLang, languages, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/xingtan/');
const title = lang === 'en' ? 'Xingtan' : '杏坛 Xingtan';
---

<BaseLayout title={title} lang={lang as Lang}>
  <XingtanLanding lang={lang as Lang} />
</BaseLayout>
