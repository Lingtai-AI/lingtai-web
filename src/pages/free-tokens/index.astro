---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FREE_TOKENS_JSON_URL, FREE_TOKENS_REPO_URL, freeTokensData } from '../../data/freeTokens';

const items = freeTokensData.items;
const updatedDate = new Date(freeTokensData.updatedAt).toISOString().slice(0, 10);
const totalProviders = items.length;
const regions = Array.from(new Set(items.map((item) => item.region))).sort();
const categories = Array.from(new Set(items.map((item) => item.category))).sort();
---

<BaseLayout title="Free AI Tokens" lang="en">
  <main class="free-token-page">
    <section class="hero" data-snap>
      <p class="eyebrow">LingTai maintained index</p>
      <h1>Free AI Tokens<br /><span>& API Credits</span></h1>
      <p class="subtitle">
        A living index of official free-tier, trial-credit, daily-quota, and free-model programs for model APIs.
        <span>免费 AI Token / API 额度索引：只收录可追溯到官方来源的活动。</span>
      </p>
      <div class="hero-actions">
        <a class="primary" href={FREE_TOKENS_REPO_URL} target="_blank" rel="noopener noreferrer">Maintained GitHub repo ↗</a>
        <a class="secondary" href={FREE_TOKENS_JSON_URL} target="_blank" rel="noopener noreferrer">Raw JSON data ↗</a>
      </div>
      <div class="stats" aria-label="Free token index statistics">
        <div><strong>{totalProviders}</strong><span>providers</span></div>
        <div><strong>{regions.length}</strong><span>regions</span></div>
        <div><strong>{categories.length}</strong><span>offer types</span></div>
        <div><strong>{updatedDate}</strong><span>last checked</span></div>
      </div>
    </section>

    <section class="notice" data-snap>
      <div>
        <strong>Verify before relying on any quota.</strong>
        <p>{freeTokensData.disclaimer}</p>
      </div>
      <div>
        <strong>每日更新计划</strong>
        <p>数据源维护在 GitHub repo 中，并由本地 Claude Code cron 每日检查官方页面、更新 JSON/HTML。</p>
      </div>
    </section>

    <section class="browser" data-snap>
      <div class="browser-head">
        <div>
          <p class="eyebrow">Browse offers</p>
          <h2>Officially sourced free-token opportunities</h2>
        </div>
        <label class="search-wrap">
          <span>Search</span>
          <input id="offer-search" type="search" placeholder="Gemini, 中国, credits, daily…" autocomplete="off" />
        </label>
      </div>

      <div class="filters" id="filters">
        <button class="filter active" data-filter="all">All</button>
        {categories.map((category) => <button class="filter" data-filter={category}>{category}</button>)}
      </div>

      <p class="count" id="offer-count">Showing {totalProviders} offers</p>
      <div class="grid" id="offer-grid">
        {items.map((item) => (
          <article class="offer-card" data-category={item.category} data-search={`${item.provider} ${item.region} ${item.category} ${item.offer} ${item.offerZh} ${item.amount} ${item.eligibility} ${item.caveats}`.toLowerCase()}>
            <div class="card-top">
              <div>
                <p class="region">{item.region}</p>
                <h3>{item.provider}</h3>
              </div>
              <span class="badge">{item.category}</span>
            </div>
            <p class="offer-text">{item.offer}</p>
            <p class="offer-text zh">{item.offerZh}</p>
            <dl>
              <div><dt>Amount</dt><dd>{item.amount}</dd></div>
              <div><dt>Eligibility</dt><dd>{item.eligibility}</dd></div>
              <div><dt>Watch out</dt><dd>{item.caveats}</dd></div>
            </dl>
            <blockquote>“{item.sourceQuote}”</blockquote>
            <footer>
              <span>Checked {item.lastChecked}</span>
              <a href={item.officialUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a>
            </footer>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script define:vars={{ latestJsonUrl: FREE_TOKENS_JSON_URL }}>
    const search = document.getElementById('offer-search');
    const count = document.getElementById('offer-count');
    const grid = document.getElementById('offer-grid');
    const filterButtons = [...document.querySelectorAll('.filter')];
    let activeFilter = 'all';

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>'"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[ch]));
    }

    function renderItems(items) {
      grid.innerHTML = items.map((item) => `
        <article class="offer-card" data-category="${escapeHtml(item.category)}" data-search="${escapeHtml(`${item.provider} ${item.region} ${item.category} ${item.offer} ${item.offerZh} ${item.amount} ${item.eligibility} ${item.caveats}`.toLowerCase())}">
          <div class="card-top"><div><p class="region">${escapeHtml(item.region)}</p><h3>${escapeHtml(item.provider)}</h3></div><span class="badge">${escapeHtml(item.category)}</span></div>
          <p class="offer-text">${escapeHtml(item.offer)}</p>
          <p class="offer-text zh">${escapeHtml(item.offerZh)}</p>
          <dl><div><dt>Amount</dt><dd>${escapeHtml(item.amount)}</dd></div><div><dt>Eligibility</dt><dd>${escapeHtml(item.eligibility)}</dd></div><div><dt>Watch out</dt><dd>${escapeHtml(item.caveats)}</dd></div></dl>
          <blockquote>“${escapeHtml(item.sourceQuote)}”</blockquote>
          <footer><span>Checked ${escapeHtml(item.lastChecked)}</span><a href="${escapeHtml(item.officialUrl)}" target="_blank" rel="noopener noreferrer">Official source ↗</a></footer>
        </article>
      `).join('');
      applyFilters();
    }

    function applyFilters() {
      const term = (search?.value || '').trim().toLowerCase();
      const cards = [...document.querySelectorAll('.offer-card')];
      let visible = 0;
      cards.forEach((card) => {
        const matchesFilter = activeFilter === 'all' || card.dataset.category === activeFilter;
        const matchesTerm = !term || (card.dataset.search || card.textContent || '').toLowerCase().includes(term);
        const show = matchesFilter && matchesTerm;
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });
      count.textContent = `Showing ${visible} offer${visible === 1 ? '' : 's'}`;
    }

    search?.addEventListener('input', applyFilters);
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter || 'all';
        filterButtons.forEach((b) => b.classList.toggle('active', b === button));
        applyFilters();
      });
    });

    fetch(latestJsonUrl, { cache: 'no-store' })
      .then((response) => response.ok ? response.json() : null)
      .then((data) => {
        if (data?.items?.length) renderItems(data.items);
      })
      .catch(() => {});
  </script>
</BaseLayout>

<style>
  .free-token-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 8% 10%, rgba(243, 201, 105, 0.14), transparent 32rem),
      radial-gradient(circle at 90% 12%, rgba(125, 211, 252, 0.15), transparent 30rem),
      linear-gradient(180deg, rgba(2, 6, 23, 0.95), rgba(8, 13, 25, 1));
    color: #e5edf8;
    padding: 5rem min(6vw, 5rem) 6rem;
  }
  .hero, .browser, .notice { max-width: 1180px; margin: 0 auto; }
  .hero { padding: 4rem 0 2rem; }
  .eyebrow { color: #f3c969; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 0.9rem; }
  h1 { font-size: clamp(3rem, 9vw, 7rem); line-height: 0.9; letter-spacing: -0.08em; margin: 0; }
  h1 span { color: #f3c969; }
  .subtitle { color: #a9b6cc; max-width: 820px; font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.75; margin: 1.5rem 0 0; }
  .subtitle span { display: block; color: #d8cdfd; margin-top: 0.35rem; }
  .hero-actions, .stats, .notice, .browser-head, .filters { display: flex; flex-wrap: wrap; gap: 1rem; }
  .hero-actions { margin-top: 2rem; }
  .primary, .secondary, .filter { border: 1px solid rgba(243, 201, 105, 0.34); border-radius: 999px; padding: 0.78rem 1rem; text-decoration: none; color: #f3c969; background: rgba(17, 24, 39, 0.7); }
  .primary { color: #111827; background: #f3c969; box-shadow: 0 16px 50px rgba(243, 201, 105, 0.2); }
  .stats { margin-top: 2.5rem; }
  .stats div { min-width: 150px; padding: 1rem; border: 1px solid rgba(148, 163, 184, 0.24); border-radius: 20px; background: rgba(15, 23, 42, 0.7); }
  .stats strong { display: block; font-size: 1.45rem; color: #ffffff; }
  .stats span, .count { color: #8ea0ba; }
  .notice { margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .notice > div { border: 1px solid rgba(125, 211, 252, 0.24); border-radius: 24px; padding: 1.2rem; background: rgba(12, 24, 39, 0.74); }
  .notice p { color: #a9b6cc; line-height: 1.65; margin-bottom: 0; }
  .browser { margin-top: 4rem; }
  .browser-head { justify-content: space-between; align-items: end; margin-bottom: 1rem; }
  h2 { font-size: clamp(1.8rem, 4vw, 3rem); margin: 0; }
  .search-wrap { display: grid; gap: 0.4rem; color: #8ea0ba; }
  .search-wrap input { width: min(86vw, 420px); border: 1px solid rgba(148, 163, 184, 0.3); border-radius: 999px; padding: 0.85rem 1rem; color: #e5edf8; background: rgba(2, 6, 23, 0.7); }
  .filters { margin: 1.2rem 0; }
  .filter { color: #cbd5e1; cursor: pointer; }
  .filter.active, .filter:hover { color: #08111f; background: #7dd3fc; border-color: #7dd3fc; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1rem; margin-top: 1rem; }
  .offer-card { border: 1px solid rgba(148, 163, 184, 0.22); border-radius: 28px; padding: 1.2rem; background: linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(10, 16, 28, 0.92)); box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24); }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .region { color: #7dd3fc; margin: 0 0 0.35rem; font-size: 0.82rem; }
  h3 { margin: 0; font-size: 1.28rem; }
  .badge { color: #f3c969; border: 1px solid rgba(243, 201, 105, 0.36); border-radius: 999px; padding: 0.28rem 0.58rem; white-space: nowrap; font-size: 0.75rem; }
  .offer-text { line-height: 1.6; color: #e5edf8; }
  .offer-text.zh { color: #d8cdfd; }
  dl { display: grid; gap: 0.7rem; margin: 1rem 0; }
  dl div { border-top: 1px solid rgba(148, 163, 184, 0.18); padding-top: 0.7rem; }
  dt { color: #f3c969; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; }
  dd { margin: 0.2rem 0 0; color: #a9b6cc; line-height: 1.55; }
  blockquote { margin: 1rem 0; padding: 0.75rem 0 0.75rem 1rem; border-left: 3px solid #f3c969; color: #cbd5e1; font-size: 0.92rem; line-height: 1.5; }
  footer { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(148, 163, 184, 0.18); padding-top: 0.9rem; color: #8ea0ba; font-size: 0.9rem; }
  footer a { color: #f3c969; text-decoration: none; }
  footer a:hover, .hero-actions a:hover { text-decoration: underline; }
  @media (max-width: 700px) { .free-token-page { padding-inline: 1rem; } footer, .card-top { display: grid; } }
</style>
