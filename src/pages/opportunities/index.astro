---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { opportunities } from '../../data/opportunities';
---

<BaseLayout title="Opportunities · 研究机会" lang="en">
  <main class="opportunities-page">
    <section class="hero" data-snap>
      <p class="eyebrow">LingTai Opportunities · 灵台研究机会</p>
      <h1 class="serif">Open problems for agent networks</h1>
      <p class="subtitle">
        Small, sponsor-backed research directions where LingTai's agent-network architecture can become a concrete experiment.
        <span>这里收集适合用灵台做成 demo、论文式实验或长期合作的开放题目。</span>
      </p>
      <div class="hero-actions">
        <a class="primary" href="#open">View opportunities</a>
        <a class="secondary" href="https://github.com/Lingtai-AI/lingtai" target="_blank" rel="noopener noreferrer">LingTai on GitHub ↗</a>
      </div>
    </section>

    <section id="open" class="list-section" data-snap>
      <div class="section-heading">
        <p class="eyebrow">Now open</p>
        <h2 class="serif">Research directions</h2>
      </div>

      <div class="opportunity-list">
        {opportunities.map((opportunity) => (
          <article class="opportunity-card" id={opportunity.id}>
            <div class="card-top">
              <span class="status">{opportunity.status}</span>
              <span class="sponsor">{opportunity.sponsor}</span>
            </div>

            <h3 class="serif">{opportunity.title}</h3>
            <p class="title-zh">{opportunity.titleZh}</p>
            <p class="tagline">{opportunity.tagline}</p>
            <p class="tagline zh">{opportunity.taglineZh}</p>

            <div class="meta-grid">
              <div>
                <strong>Location</strong>
                <span>{opportunity.location}</span>
              </div>
              <div>
                <strong>Good fit</strong>
                <span>{opportunity.backgrounds.slice(0, 2).join(' · ')}</span>
              </div>
            </div>

            <div class="body-grid">
              <section>
                <h4>Why this matters</h4>
                <p>{opportunity.summary}</p>
                <p class="zh">{opportunity.summaryZh}</p>
              </section>

              <section>
                <h4>Research questions</h4>
                <ul>
                  {opportunity.researchQuestions.map((item, index) => (
                    <li>
                      <span>{item}</span>
                      <small>{opportunity.researchQuestionsZh[index]}</small>
                    </li>
                  ))}
                </ul>
              </section>

              <section>
                <h4>Possible LingTai design</h4>
                <ul>
                  {opportunity.methods.map((item, index) => (
                    <li>
                      <span>{item}</span>
                      <small>{opportunity.methodsZh[index]}</small>
                    </li>
                  ))}
                </ul>
              </section>

              <section>
                <h4>Expected outputs</h4>
                <ul>
                  {opportunity.outputs.map((item, index) => (
                    <li>
                      <span>{item}</span>
                      <small>{opportunity.outputsZh[index]}</small>
                    </li>
                  ))}
                </ul>
              </section>
            </div>

            <div class="notes">
              {opportunity.notes.map((item, index) => (
                <p>
                  <span>{item}</span>
                  <small>{opportunity.notesZh[index]}</small>
                </p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .opportunities-page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px 96px;
  }

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 48px 0 72px;
  }

  .eyebrow {
    color: var(--text-faint);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  h1 {
    color: var(--title-color);
    font-size: clamp(40px, 8vw, 78px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: 2px;
    max-width: 920px;
  }

  .subtitle {
    max-width: 720px;
    color: var(--text-dim);
    font-size: 17px;
    line-height: 1.8;
    margin-top: 28px;
  }

  .subtitle span {
    display: block;
    color: var(--text-faint);
    margin-top: 6px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }

  .primary,
  .secondary {
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 13px;
    letter-spacing: 0.5px;
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }

  .secondary {
    color: var(--accent);
  }

  .section-heading {
    text-align: center;
    margin-bottom: 36px;
  }

  .section-heading h2 {
    color: var(--title-color);
    font-weight: 300;
    font-size: 34px;
    letter-spacing: 3px;
  }

  .opportunity-list {
    display: grid;
    gap: 28px;
  }

  .opportunity-card {
    border: 1px solid rgba(138, 134, 128, 0.22);
    border-radius: 28px;
    padding: clamp(24px, 4vw, 44px);
    background: linear-gradient(135deg, rgba(125, 171, 143, 0.08), rgba(196, 154, 108, 0.06));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.06);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .status {
    color: var(--bg);
    background: var(--accent);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .sponsor {
    color: var(--text-faint);
    font-size: 13px;
  }

  h3 {
    color: var(--title-color);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 300;
    line-height: 1.12;
    margin-bottom: 8px;
  }

  .title-zh {
    color: var(--text-dim);
    font-size: 20px;
    margin-bottom: 20px;
  }

  .tagline {
    color: var(--text-dim);
    font-size: 16px;
    line-height: 1.7;
  }

  .tagline.zh,
  .zh,
  small {
    color: var(--text-faint);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 30px 0;
  }

  .meta-grid div {
    border-top: 1px solid rgba(138, 134, 128, 0.2);
    padding-top: 14px;
  }

  .meta-grid strong {
    display: block;
    color: var(--accent-warm);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  .meta-grid span {
    color: var(--text-dim);
    font-size: 14px;
  }

  .body-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  h4 {
    color: var(--title-color);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  section p,
  li {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.75;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 12px;
  }

  li {
    position: relative;
    padding-left: 18px;
  }

  li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent-warm);
  }

  li span,
  li small,
  .notes span,
  .notes small {
    display: block;
  }

  .notes {
    border-top: 1px solid rgba(138, 134, 128, 0.2);
    margin-top: 30px;
    padding-top: 18px;
    display: grid;
    gap: 10px;
  }

  .notes p {
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .meta-grid,
    .body-grid {
      grid-template-columns: 1fr;
    }

    .opportunities-page {
      padding-inline: 18px;
    }
  }
</style>
