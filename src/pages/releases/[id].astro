---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releases } from '../../data/releases';

export function getStaticPaths() {
  return releases.map((release) => ({
    params: { id: release.id },
    props: { release },
  }));
}

const { release } = Astro.props;

// Render a string with backtick spans as <code>.
function splitCode(text: string): Array<{ kind: 'text' | 'code'; value: string }> {
  const parts: Array<{ kind: 'text' | 'code'; value: string }> = [];
  const re = /`([^`]+)`/g;
  let last = 0;
  let match: RegExpExecArray | null;
  while ((match = re.exec(text)) !== null) {
    if (match.index > last) parts.push({ kind: 'text', value: text.slice(last, match.index) });
    parts.push({ kind: 'code', value: match[1] });
    last = match.index + match[0].length;
  }
  if (last < text.length) parts.push({ kind: 'text', value: text.slice(last) });
  return parts;
}
---

<BaseLayout title={`${release.version} · ${release.titleZh}`} lang="en">
  <main class="release-detail">
    <a class="back-link" href="/releases/">← Releases</a>

    <header class="detail-header">
      <p class="meta-row">
        <span class="release-id">id <span class="mono">{release.id}</span></span>
        <span class="meta-sep">·</span>
        <span class="release-date">{release.date}</span>
        <span class="meta-sep">·</span>
        <span class="tag mono">{release.tag}</span>
      </p>
      <h1 class="version serif">{release.version}</h1>
      <h2 class="zh-title serif">{release.titleZh}</h2>
      <h2 class="en-title">{release.titleEn}</h2>
      <div class="divider"></div>

      <div class="summaries">
        <p class="summary zh">{release.summaryZh}</p>
        <p class="summary">{release.summaryEn}</p>
      </div>
    </header>

    <section class="install-block">
      <h3 class="section-heading">Install · 安装</h3>
      <div class="install-pill">
        <span class="prompt">$</span>
        <span class="command">{release.install}</span>
        <button class="copy-btn" data-command={release.install}>copy</button>
      </div>
    </section>

    <section class="features">
      <h3 class="section-heading">New features and improvements · 新功能与改进</h3>
      <ol class="feature-list">
        {release.features.map((feature, idx) => (
          <li class="feature">
            <p class="feature-number serif">{String(idx + 1).padStart(2, '0')}</p>
            <div class="feature-titles">
              <h4 class="feature-title-zh serif">{feature.titleZh}</h4>
              <h4 class="feature-title-en">{feature.titleEn}</h4>
            </div>

            <div class="feature-body">
              <div class="col zh">
                <p class="lead">
                  {splitCode(feature.leadZh).map((p) =>
                    p.kind === 'code' ? <code>{p.value}</code> : <span>{p.value}</span>,
                  )}
                </p>
                <ul>
                  {feature.bulletsZh.map((b) => (
                    <li>
                      {splitCode(b).map((p) =>
                        p.kind === 'code' ? <code>{p.value}</code> : <span>{p.value}</span>,
                      )}
                    </li>
                  ))}
                </ul>
                <p class="why"><strong>为什么重要：</strong>{feature.whyZh}</p>
              </div>
              <div class="col en">
                <p class="lead">
                  {splitCode(feature.leadEn).map((p) =>
                    p.kind === 'code' ? <code>{p.value}</code> : <span>{p.value}</span>,
                  )}
                </p>
                <ul>
                  {feature.bulletsEn.map((b) => (
                    <li>
                      {splitCode(b).map((p) =>
                        p.kind === 'code' ? <code>{p.value}</code> : <span>{p.value}</span>,
                      )}
                    </li>
                  ))}
                </ul>
                <p class="why"><strong>Why it matters:</strong> {feature.whyEn}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="contributors-block">
      <h3 class="section-heading">Contributors · 贡献者</h3>
      <p class="contributor-note">
        Thanks to everyone whose PRs or reported/closed issues are represented
        in this release window.<br />
        <span class="zh-note">感谢本发布窗口中提交 PR、报告问题或推动 issue closure 的贡献者。</span>
      </p>
      <ul class="contributor-list">
        {release.contributors.map((name) => (
          <li>
            <a href={`https://github.com/${name}`} target="_blank" rel="noopener">
              @{name}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="validation-block">
      <h3 class="section-heading">Validation · 验证</h3>
      {release.validation.commit && (
        <p class="commit-note">
          Final release validation was run from a clean release worktree at commit
          <code class="commit-hash">{release.validation.commit.slice(0, 12)}</code>.
        </p>
      )}
      <ul class="validation-list">
        {release.validation.items.map((item) => (
          <li>
            <span class="val-label">{item.label}</span>
            <span class="val-dots" aria-hidden="true"></span>
            <span class="val-result">{item.result}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="links-block">
      <h3 class="section-heading">Links · 链接</h3>
      <ul class="link-list">
        {release.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">{l.label} →</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.command;
      if (!cmd) return;
      navigator.clipboard.writeText(cmd);
      const original = btn.textContent;
      btn.textContent = '✓';
      setTimeout(() => {
        btn.textContent = original;
      }, 1500);
    });
  });
</script>

<style>
  .release-detail {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px 24px 96px;
  }
  .back-link {
    display: inline-block;
    color: var(--text-faint);
    font-size: 13px;
    letter-spacing: 1px;
    margin-bottom: 32px;
  }
  .back-link:hover {
    color: var(--accent);
  }

  .detail-header {
    margin-bottom: 48px;
  }
  .meta-row {
    font-size: 12px;
    letter-spacing: 1.5px;
    color: var(--text-faint);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .meta-sep {
    margin: 0 8px;
    color: var(--text-faint);
    opacity: 0.6;
  }
  .release-id .mono,
  .tag {
    text-transform: none;
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    color: var(--text-dim);
  }
  .version {
    font-size: 56px;
    font-weight: 300;
    letter-spacing: 3px;
    color: var(--title-color);
    margin-bottom: 6px;
    line-height: 1.1;
  }
  .zh-title {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--text);
    margin-bottom: 2px;
  }
  .en-title {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 1px;
    color: var(--text-faint);
  }
  .divider {
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin: 28px 0;
  }
  .summaries {
    display: grid;
    gap: 14px;
  }
  .summary {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-dim);
  }
  .summary.zh {
    color: var(--text);
  }

  .section-heading {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 18px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(138, 134, 128, 0.18);
  }

  .install-block {
    margin-top: 48px;
    margin-bottom: 48px;
  }
  .install-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 12px 18px;
    border-radius: 6px;
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    font-size: 13px;
  }
  .prompt {
    color: var(--text-faint);
  }
  .command {
    flex: 1;
    overflow-x: auto;
    white-space: nowrap;
  }
  .copy-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-size: 11px;
    cursor: pointer;
    opacity: 0.7;
    font-family: inherit;
  }
  .copy-btn:hover {
    opacity: 1;
  }

  .features {
    margin-bottom: 56px;
  }
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 48px;
  }
  .feature {
    position: relative;
  }
  .feature-number {
    font-size: 12px;
    letter-spacing: 4px;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .feature-titles {
    margin-bottom: 18px;
  }
  .feature-title-zh {
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 1.5px;
    color: var(--text);
    margin-bottom: 4px;
  }
  .feature-title-en {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.5px;
    color: var(--text-faint);
  }

  .feature-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 880px) {
    .feature-body {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
  .col {
    font-size: 14px;
    line-height: 1.75;
  }
  .col.zh {
    color: var(--text);
  }
  .col.en {
    color: var(--text-dim);
  }
  .col .lead {
    margin-bottom: 10px;
  }
  .col ul {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
  }
  .col ul li {
    position: relative;
    padding-left: 16px;
    margin-bottom: 6px;
  }
  .col ul li::before {
    content: '·';
    position: absolute;
    left: 4px;
    color: var(--accent);
    font-weight: 700;
  }
  .col code {
    background: var(--bg-alt);
    padding: 1px 6px;
    border-radius: 3px;
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    font-size: 0.88em;
    color: var(--text);
  }
  .col .why {
    margin-top: 12px;
    padding: 10px 14px;
    background: rgba(125, 171, 143, 0.06);
    border-left: 2px solid var(--accent);
    font-size: 13px;
    color: var(--text-dim);
  }
  .col .why strong {
    color: var(--accent);
    font-weight: 600;
  }

  .contributors-block {
    margin-bottom: 48px;
  }
  .contributor-note {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .zh-note {
    color: var(--text-faint);
  }
  .contributor-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .contributor-list li a {
    display: inline-block;
    padding: 4px 12px;
    border: 1px solid rgba(138, 134, 128, 0.25);
    border-radius: 999px;
    font-size: 13px;
    color: var(--text-dim);
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
  }
  .contributor-list li a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .validation-block {
    margin-bottom: 48px;
  }
  .commit-note {
    font-size: 13px;
    color: var(--text-faint);
    margin-bottom: 16px;
  }
  .commit-hash {
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    background: var(--bg-alt);
    padding: 1px 6px;
    border-radius: 3px;
    color: var(--text-dim);
    font-size: 0.92em;
    margin-left: 6px;
  }
  .validation-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .validation-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 13px;
  }
  .val-label {
    color: var(--text-dim);
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
  }
  .val-dots {
    flex: 1;
    border-bottom: 1px dotted rgba(138, 134, 128, 0.35);
    transform: translateY(-3px);
  }
  .val-result {
    color: var(--accent);
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
    text-align: right;
  }

  .links-block {
    margin-bottom: 24px;
  }
  .link-list {
    list-style: none;
    padding: 0;
  }
  .link-list li {
    margin-bottom: 8px;
    font-size: 14px;
  }
</style>
