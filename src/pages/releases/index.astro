---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releases } from '../../data/releases';

const sorted = [...releases].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<BaseLayout title="Releases · 发布" lang="en">
  <main class="releases">
    <header class="releases-header">
      <p class="eyebrow">Release archive · 发布纪</p>
      <h1 class="title serif">Releases</h1>
      <div class="divider"></div>
      <p class="intro">
        A bilingual log of LingTai kernel releases. Each entry links to the
        published artifact and the validation that accompanied it.
      </p>
      <p class="intro zh">
        灵台内核的发布纪录，中英对照。每条记录都附有发布产物与配套验证。
      </p>
    </header>

    {sorted.length === 0 ? (
      <p class="empty">No releases yet.</p>
    ) : (
      <ol class="release-list">
        {sorted.map((release) => (
          <li class="release-row">
            <a class="release-link" href={`/releases/${release.id}/`}>
              <div class="row-top">
                <span class="version serif">{release.version}</span>
                <span class="date">{release.date}</span>
              </div>
              <div class="row-titles">
                <span class="row-title">{release.titleEn}</span>
                <span class="row-title zh">{release.titleZh}</span>
              </div>
              <p class="row-summary">{release.summaryEn}</p>
              <p class="row-summary zh">{release.summaryZh}</p>
            </a>
          </li>
        ))}
      </ol>
    )}
  </main>
</BaseLayout>

<style>
  .releases {
    max-width: 880px;
    margin: 0 auto;
    padding: 60px 24px 96px;
  }
  .releases-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .title {
    font-size: 40px;
    font-weight: 300;
    letter-spacing: 6px;
    color: var(--title-color);
    margin-top: 8px;
  }
  .divider {
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin: 18px auto;
  }
  .intro {
    max-width: 580px;
    margin: 0 auto;
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.7;
  }
  .intro.zh {
    margin-top: 8px;
    color: var(--text-faint);
  }
  .empty {
    text-align: center;
    color: var(--text-faint);
    padding: 60px 0;
  }

  .release-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid rgba(138, 134, 128, 0.18);
  }
  .release-row {
    border-bottom: 1px solid rgba(138, 134, 128, 0.18);
  }
  .release-link {
    display: block;
    padding: 28px 4px;
    color: var(--text);
    transition: background 160ms ease;
  }
  .release-link:hover {
    background: rgba(125, 171, 143, 0.04);
  }
  .row-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }
  .version {
    font-size: 22px;
    letter-spacing: 1.5px;
    color: var(--title-color);
  }
  .date {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-faint);
    font-family: "SF Mono", "Fira Code", Menlo, Consolas, monospace;
  }
  .row-titles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    color: var(--text-dim);
    font-size: 15px;
    margin-bottom: 10px;
  }
  .row-title.zh {
    color: var(--text-faint);
  }
  .row-summary {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 6px;
  }
  .row-summary.zh {
    color: var(--text-faint);
    margin-bottom: 0;
  }

  .release-link:hover .version,
  .release-link:hover .row-title {
    color: var(--accent);
  }
</style>
